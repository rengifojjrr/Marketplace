{
  "name": "tumbo-market-beta",
  "version": "1.0.0-beta",
  "private": true,
  "description": "Beta funcional de Tumbo Market: marketplace curado de Venezuela con tienda, Seller Center y Backoffice interconectados sobre Supabase (con modo local de respaldo).",
  "scripts": {
    "start": "python3 serve.py 8000",
    "build": "npm run build:css && npm run build:paginas",
    "build:css": "tailwindcss -c tailwind.config.js -i tools/tumbo-entrada.css -o assets/css/tumbo-tailwind.css --minify",
    "build:paginas": "python3 tools/generar_paginas.py",
    "build:prototipo": "python3 tools/build.py && python3 tools/generar_prototipo_indice.py",
    "build:fuentes": "python3 tools/fuentes.py",
    "test": "node tools/verificar-beta.js",
    "test:nube": "TM_NUBE=1 node tools/verificar-beta.js https://rengifojjrr.github.io/Marketplace",
    "test:api": "node tools/verificar-rls.js",
    "test:todo": "node tools/verificar-todo.js http://localhost:8000"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "axe-core": "4.13.0",
    "playwright": "1.56.1",
    "tailwindcss": "^3.4.17"
  },
  "license": "UNLICENSED"
}
